# Copy this file to .env.jira and fill in your values.
#
#   cp .env.jira.example .env.jira
#   chmod 600 .env.jira
#
# .env.jira is git-ignored. Never commit it, never paste its contents anywhere.
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_SITE=https://yourname.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=paste_your_token_here
JIRA_PROJECT_KEY=REV
