POSTGRES_PASSWORD=your-password
JWT_SECRET_KEY=ini-jtw-harus-panjang-banget-2026
MIDTRANS_SERVER_KEY="ambil-dari-midtrans"
MIDTRANS_CLIENT_KEY="ambil-dari-midtrans"
MIDTRANS_IS_PRODUCTION=false
# Frontend origin(s) allowed to call the API, comma-separated; empty blocks all browsers
CORS_ORIGINS=https://app.your-domain.com
# Product images: the S3 (or CDN) root that image keys are joined to
IMAGE_BASE_URL=https://BUCKET.s3.REGION.amazonaws.com
# Upload endpoint. Empty bucket disables it. On EC2 use an instance IAM role and
# leave the two keys unset; set them only when running outside AWS.
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Local: leave SITE_ADDRESS=:80 and open http://localhost:8080 · Server: SITE_ADDRESS=api.your-domain.com, HTTP_PORT=80, HTTPS_PORT=443
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
WEB_CONCURRENCY=2