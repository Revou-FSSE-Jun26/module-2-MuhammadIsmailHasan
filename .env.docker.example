# --- Database (compose builds DATABASE_URL from these) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=revoshop_db
WEB_PORT=5000
DB_PORT=5432

# --- Auth ---
JWT_SECRET_KEY=replace-with-your-secret-key
JWT_ACCESS_TOKEN_EXPIRES=15
JWT_REFRESH_TOKEN_EXPIRES=7

# --- Gunicorn ---
GUNICORN_WORKERS=3

# --- Browser access (comma-separated origins; dev defaults to localhost ports) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Product images ---
# Prefix joined to the stored image key. Empty = /static/images served by Flask.
IMAGE_BASE_URL=
# Upload endpoint. Leave AWS_S3_BUCKET empty to disable it (503).
# On EC2 prefer an instance IAM role and leave both keys empty.
AWS_S3_BUCKET=
AWS_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Midtrans payment gateway (get keys from https://dashboard.sandbox.midtrans.com) ---
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=1440
