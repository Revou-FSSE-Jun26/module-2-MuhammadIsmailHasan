# Environment: 'development' or 'production'. Selects the config class.
FLASK_ENV=development

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
JWT_SECRET_KEY="replace-with-your-secret-key"
JWT_ACCESS_TOKEN_EXPIRES=1
JWT_REFRESH_TOKEN_EXPIRES=30

# Midtrans payment gateway (get keys from https://dashboard.sandbox.midtrans.com)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=1440

# Logging (all optional; defaults shown)
# Log file rotates daily at midnight; LOG_BACKUP_COUNT = days of history kept.
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
LOG_FILE=app.log
LOG_BACKUP_COUNT=30

# Locust load test (all optional; only used when running locust, defaults shown)
# LOCUST_TEST_PAYMENTS=true also exercises POST /payments (calls Midtrans).
LOCUST_EMAIL=jane@example.com
LOCUST_PASSWORD=password123
LOCUST_SELLER_EMAIL=alice@example.com
LOCUST_SELLER_PASSWORD=password123
LOCUST_TEST_PAYMENTS=false
